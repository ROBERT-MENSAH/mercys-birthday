# Files that must never be uploaded to Vercel.
# The browser test suites write real Chrome profiles here, including cookie and
# saved-login databases, so they are excluded explicitly rather than relying on
# .gitignore being honoured at upload time.

# local browser profiles and test output
.browse/
.browse-tap/
.browse-icons/
.browse-shots/
shots/

# build output is regenerated by the build command on Vercel
dist/

# tooling and dependencies
node_modules/
.vercel/

# logs and scratch files
*.log
*.err
browse.txt
all.txt
push.txt
v*.txt
.env*
