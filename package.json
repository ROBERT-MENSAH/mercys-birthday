{
  "name": "mercy-birthday",
  "version": "1.0.0",
  "private": true,
  "description": "A premium, pink-led, mobile-first birthday experience for Mercy, built from her real photographs and videos.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "icons": "node tools/makeicons-photo.mjs",
    "webp": "node tools/makewebp.mjs",
    "webp:force": "node tools/makewebp.mjs --force",
    "icons:monogram": "node tools/makeicons.mjs",
    "check": "node tools/check.mjs && node tools/captioncheck.mjs",
    "test": "node tools/selftest.mjs",
    "start": "npm run build && node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "browser": "node tools/browsertest.mjs",
    "tap": "node tools/tapprobe.mjs",
    "dev": "node tools/build.mjs && node tools/check.mjs",
    "all": "node tools/makeicons-photo.mjs && node tools/build.mjs && node tools/check.mjs && node tools/selftest.mjs && node tools/browsertest.mjs"
  },
  "keywords": ["birthday", "static-site", "no-dependencies"],
  "license": "UNLICENSED"
}
